{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "logging_config.JSONLogFormatter"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "_granian": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    },
    "granian.access": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": false
    }
  }
}
